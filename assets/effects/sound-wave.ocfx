{
  "openchroma": 1,
  "name": "Sound Wave",
  "description": "A wave of light that grows with the volume and runs across your setup.",
  "author": "OpenChroma",
  "i18n": {
    "pt": {
      "name": "Onda Sonora",
      "description": "Uma onda de luz que cresce com o volume e corre pelo setup.",
      "params": {
        "color": "Cor da onda",
        "speed": "Velocidade"
      }
    }
  },
  "background": "#020814",
  "params": {
    "color": {
      "label": "Wave color",
      "type": "color",
      "default": "#3CFFB4"
    },
    "speed": {
      "label": "Speed",
      "type": "number",
      "min": 0,
      "max": 100,
      "default": 45
    }
  },
  "layers": [
    {
      "type": "gradient",
      "colors": [
        "#04122B",
        "#0B0526",
        "#04122B"
      ],
      "angle": 0,
      "speed": 15
    },
    {
      "type": "wave",
      "color": "$color",
      "amplitude": "@level",
      "frequency": 1.6,
      "thickness": 0.22,
      "speed": "$speed",
      "blend": "screen"
    },
    {
      "type": "wave",
      "color": "#8B5CF6",
      "amplitude": "@bass",
      "frequency": 0.9,
      "thickness": 0.16,
      "position": 0.55,
      "speed": 25,
      "blend": "screen",
      "opacity": 0.7
    }
  ]
}
