{
  "openchroma": 1,
  "name": "Neon Rings",
  "description": "Pink and cyan rings expanding from the center.",
  "author": "OpenChroma",
  "i18n": {
    "pt": {
      "name": "Anéis Neon",
      "description": "Anéis rosa e ciano se expandindo a partir do centro.",
      "params": {
        "speed": "Velocidade",
        "spacing": "Espaçamento"
      }
    }
  },
  "background": "#07020F",
  "params": {
    "speed": {
      "label": "Speed",
      "type": "number",
      "min": 0,
      "max": 100,
      "default": 35
    },
    "spacing": {
      "label": "Spacing",
      "type": "number",
      "min": 16,
      "max": 120,
      "default": 48
    }
  },
  "layers": [
    {
      "type": "rings",
      "colors": [
        "#FF2EC4",
        "#2EE6FF",
        "#7B2CFF"
      ],
      "spacing": "$spacing",
      "thickness": 0.55,
      "speed": "$speed"
    }
  ]
}
