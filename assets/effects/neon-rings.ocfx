{
  "openchroma": 1,
  "name": "Anéis Neon",
  "description": "Anéis rosa e ciano se expandindo a partir do centro.",
  "author": "OpenChroma",
  "background": "#07020F",
  "params": {
    "speed": {
      "label": "Velocidade",
      "type": "number",
      "min": 0,
      "max": 100,
      "default": 35
    },
    "spacing": {
      "label": "Espaçamento",
      "type": "number",
      "min": 16,
      "max": 120,
      "default": 48
    }
  },
  "layers": [
    {
      "type": "rings",
      "colors": [
        "#FF2EC4",
        "#2EE6FF",
        "#7B2CFF"
      ],
      "spacing": "$spacing",
      "thickness": 0.55,
      "speed": "$speed"
    }
  ]
}
