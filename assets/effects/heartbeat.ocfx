{
  "openchroma": 1,
  "name": "Heartbeat",
  "description": "Two quick beats and a pause, like a heart.",
  "author": "OpenChroma",
  "i18n": {
    "pt": {
      "name": "Batimento",
      "description": "Duas batidas rápidas e uma pausa, como um coração.",
      "params": {
        "color": "Cor",
        "speed": "Ritmo"
      }
    }
  },
  "background": "#000000",
  "params": {
    "color": {
      "label": "Color",
      "type": "color",
      "default": "#EF4444"
    },
    "speed": {
      "label": "Pace",
      "type": "number",
      "min": 1,
      "max": 100,
      "default": 30
    }
  },
  "layers": [
    {
      "type": "heartbeat",
      "color": "$color",
      "speed": "$speed"
    }
  ]
}
