{
  "openchroma": 1,
  "name": "Volume Meter",
  "description": "A meter that fills from the center to the edges with the volume, from green to red.",
  "author": "OpenChroma",
  "i18n": {
    "pt": {
      "name": "Medidor de Volume",
      "description": "Um medidor que enche do centro para as pontas conforme o volume, do verde ao vermelho."
    }
  },
  "background": "#050505",
  "params": {},
  "layers": [
    {
      "type": "meter",
      "value": "@level",
      "from": "center",
      "colors": [
        "#22C55E",
        "#22C55E",
        "#FACC15",
        "#EF4444"
      ]
    },
    {
      "type": "flash",
      "color": "#FFFFFF",
      "value": "@beat",
      "strength": 0.12
    }
  ]
}
