{
  "openchroma": 1,
  "name": "Storm",
  "description": "Dark clouds rolling by with the occasional flash of lightning.",
  "author": "OpenChroma",
  "i18n": {
    "pt": {
      "name": "Tempestade",
      "description": "Nuvens escuras se movendo com relâmpagos de vez em quando.",
      "params": {
        "speed": "Velocidade"
      }
    }
  },
  "background": "#000000",
  "params": {
    "speed": {
      "label": "Speed",
      "type": "number",
      "min": 0,
      "max": 100,
      "default": 30
    }
  },
  "layers": [
    {
      "type": "noise",
      "colors": [
        "#020617",
        "#1E293B",
        "#334155"
      ],
      "scale": 1.4,
      "speed": "$speed"
    },
    {
      "type": "sparkle",
      "color": "#E0F2FE",
      "density": 3,
      "size": 160,
      "speed": 12,
      "blend": "add"
    }
  ]
}
