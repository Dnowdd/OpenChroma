{
  "openchroma": 1,
  "name": "Fireflies",
  "description": "Points of light that flicker on and off at random over a calm background.",
  "author": "OpenChroma",
  "i18n": {
    "pt": {
      "name": "Vaga-lumes",
      "description": "Pontos de luz que acendem e apagam em lugares aleatórios sobre um fundo calmo.",
      "params": {
        "color": "Cor dos pontos",
        "amount": "Quantidade",
        "speed": "Velocidade"
      }
    }
  },
  "background": "#03100A",
  "params": {
    "color": {
      "label": "Dot color",
      "type": "color",
      "default": "#C8FF5A"
    },
    "amount": {
      "label": "Amount",
      "type": "number",
      "min": 5,
      "max": 150,
      "default": 60
    },
    "speed": {
      "label": "Speed",
      "type": "number",
      "min": 0,
      "max": 100,
      "default": 30
    }
  },
  "layers": [
    {
      "type": "gradient",
      "colors": [
        "#04140C",
        "#0A2416",
        "#04140C"
      ],
      "angle": 30,
      "speed": 10
    },
    {
      "type": "sparkle",
      "color": "$color",
      "density": "$amount",
      "size": 9,
      "speed": "$speed",
      "blend": "add"
    }
  ]
}
