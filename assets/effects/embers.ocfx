{
  "openchroma": 1,
  "name": "Embers",
  "description": "Warm reds and oranges with rising sparks, like glowing coals.",
  "author": "OpenChroma",
  "i18n": {
    "pt": {
      "name": "Brasa",
      "description": "Vermelhos e laranjas quentes com fagulhas subindo, como carvão em brasa.",
      "params": {
        "speed": "Velocidade",
        "sparks": "Fagulhas"
      }
    }
  },
  "background": "#120200",
  "params": {
    "speed": {
      "label": "Speed",
      "type": "number",
      "min": 0,
      "max": 100,
      "default": 30
    },
    "sparks": {
      "label": "Sparks",
      "type": "number",
      "min": 0,
      "max": 120,
      "default": 45
    }
  },
  "layers": [
    {
      "type": "gradient",
      "colors": [
        "#7A0A00",
        "#E8400C",
        "#FF8A00",
        "#B31B00"
      ],
      "angle": 90,
      "scale": 1.3,
      "speed": "$speed"
    },
    {
      "type": "sparkle",
      "color": "#FFD27A",
      "density": "$sparks",
      "size": 7,
      "speed": 60,
      "blend": "add"
    }
  ]
}
