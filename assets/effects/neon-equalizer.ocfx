{
  "openchroma": 1,
  "name": "Neon Equalizer",
  "description": "An equalizer mirrored from the center, in pink and cyan.",
  "author": "OpenChroma",
  "i18n": {
    "pt": {
      "name": "Equalizador Neon",
      "description": "Equalizador espelhado a partir do centro, em rosa e ciano.",
      "params": {
        "edgeColor": "Cor das bordas",
        "centerColor": "Cor do centro",
        "gain": "Sensibilidade"
      }
    }
  },
  "background": "#07020F",
  "params": {
    "edgeColor": {
      "label": "Edge color",
      "type": "color",
      "default": "#2EE6FF"
    },
    "centerColor": {
      "label": "Center color",
      "type": "color",
      "default": "#FF2EC4"
    },
    "gain": {
      "label": "Sensitivity",
      "type": "number",
      "min": 20,
      "max": 200,
      "default": 100
    }
  },
  "layers": [
    {
      "type": "bars",
      "colors": [
        "$centerColor",
        "$edgeColor"
      ],
      "mirror": true,
      "from": "center",
      "count": 40,
      "gain": "$gain",
      "gap": 0.3
    },
    {
      "type": "flash",
      "color": "$centerColor",
      "value": "@beat",
      "strength": 0.25,
      "blend": "screen"
    }
  ]
}
