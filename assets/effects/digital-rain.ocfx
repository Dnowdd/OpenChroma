{
  "openchroma": 1,
  "name": "Chuva Digital",
  "description": "Gotas de luz caindo em colunas, como um terminal antigo.",
  "author": "OpenChroma",
  "background": "#010A03",
  "params": {
    "color": {
      "label": "Cor",
      "type": "color",
      "default": "#22C55E"
    },
    "speed": {
      "label": "Velocidade",
      "type": "number",
      "min": 0,
      "max": 100,
      "default": 40
    },
    "density": {
      "label": "Quantidade",
      "type": "number",
      "min": 5,
      "max": 80,
      "default": 32
    }
  },
  "layers": [
    {
      "type": "rain",
      "color": "$color",
      "density": "$density",
      "length": 0.4,
      "speed": "$speed"
    }
  ]
}
