{
  "openchroma": 1,
  "name": "Spectrum",
  "description": "Bars that rise and fall with each frequency of the music, from bass to treble.",
  "author": "OpenChroma",
  "i18n": {
    "pt": {
      "name": "Espectro",
      "description": "Barras que sobem e descem com cada frequência da música, do grave ao agudo.",
      "params": {
        "gain": "Sensibilidade",
        "bars": "Barras"
      }
    }
  },
  "background": "#05060A",
  "params": {
    "gain": {
      "label": "Sensitivity",
      "type": "number",
      "min": 20,
      "max": 200,
      "default": 100
    },
    "bars": {
      "label": "Bars",
      "type": "number",
      "min": 8,
      "max": 64,
      "default": 32
    }
  },
  "layers": [
    {
      "type": "bars",
      "colors": "spectrum",
      "count": "$bars",
      "gain": "$gain",
      "gap": 0.25
    }
  ]
}
