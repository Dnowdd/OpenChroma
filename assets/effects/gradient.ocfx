{
  "openchroma": 1,
  "name": "Gradient",
  "description": "Two colors of your choice sliding into each other.",
  "author": "OpenChroma",
  "i18n": {
    "pt": {
      "name": "Degradê",
      "description": "Duas cores à sua escolha deslizando uma na outra.",
      "params": {
        "first": "Cor 1",
        "second": "Cor 2",
        "speed": "Velocidade",
        "angle": "Direção"
      }
    }
  },
  "background": "#000000",
  "params": {
    "first": {
      "label": "Color 1",
      "type": "color",
      "default": "#00E5FF"
    },
    "second": {
      "label": "Color 2",
      "type": "color",
      "default": "#FF00C8"
    },
    "speed": {
      "label": "Speed",
      "type": "number",
      "min": 0,
      "max": 100,
      "default": 25
    },
    "angle": {
      "label": "Direction",
      "type": "number",
      "min": 0,
      "max": 360,
      "default": 0
    }
  },
  "layers": [
    {
      "type": "gradient",
      "colors": [
        "$first",
        "$second"
      ],
      "angle": "$angle",
      "scale": 1.2,
      "speed": "$speed"
    }
  ]
}
