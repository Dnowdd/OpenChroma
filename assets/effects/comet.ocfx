{
  "openchroma": 1,
  "name": "Cometa",
  "description": "Um feixe de luz que atravessa o setup de ponta a ponta sobre um fundo escuro.",
  "author": "OpenChroma",
  "background": "#02030A",
  "params": {
    "color": {
      "label": "Cor do cometa",
      "type": "color",
      "default": "#FFFFFF"
    },
    "trailColor": {
      "label": "Cor do rastro",
      "type": "color",
      "default": "#4C8DFF"
    },
    "speed": {
      "label": "Velocidade",
      "type": "number",
      "min": 0,
      "max": 100,
      "default": 45
    },
    "bounce": {
      "label": "Ida e volta",
      "type": "boolean",
      "default": false
    }
  },
  "layers": [
    {
      "type": "sweep",
      "color": "$trailColor",
      "width": 0.6,
      "speed": "$speed",
      "bounce": "$bounce",
      "opacity": 0.35
    },
    {
      "type": "sweep",
      "color": "$color",
      "width": 0.12,
      "speed": "$speed",
      "bounce": "$bounce",
      "blend": "add"
    }
  ]
}
