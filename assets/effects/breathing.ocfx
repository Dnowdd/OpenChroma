{
  "openchroma": 1,
  "name": "Respiração",
  "description": "Uma cor que acende e apaga suavemente, no ritmo de uma respiração.",
  "author": "OpenChroma",
  "background": "#000000",
  "params": {
    "cor": { "label": "Cor", "type": "color", "default": "#4C8DFF" },
    "velocidade": { "label": "Ritmo", "type": "number", "min": 1, "max": 100, "default": 25 },
    "minimo": { "label": "Brilho mínimo", "type": "number", "min": 0, "max": 100, "default": 5 }
  },
  "layers": [
    { "type": "pulse", "color": "$cor", "speed": "$velocidade", "min": "$minimo", "max": 1 }
  ]
}
