{
  "openchroma": 1,
  "name": "Respiração",
  "description": "Uma cor que acende e apaga suavemente, no ritmo de uma respiração.",
  "author": "OpenChroma",
  "background": "#000000",
  "params": {
    "color": {
      "label": "Cor",
      "type": "color",
      "default": "#4C8DFF"
    },
    "speed": {
      "label": "Ritmo",
      "type": "number",
      "min": 1,
      "max": 100,
      "default": 25
    },
    "minimum": {
      "label": "Brilho mínimo",
      "type": "number",
      "min": 0,
      "max": 100,
      "default": 5
    }
  },
  "layers": [
    {
      "type": "pulse",
      "color": "$color",
      "speed": "$speed",
      "min": "$minimum",
      "max": 1
    }
  ]
}
