{
  "openchroma": 1,
  "name": "Starry Sky",
  "description": "Stars twinkling over a night blue that drifts slowly by.",
  "author": "OpenChroma",
  "i18n": {
    "pt": {
      "name": "Céu Estrelado",
      "description": "Estrelas piscando sobre um azul noturno que passa devagar.",
      "params": {
        "speed": "Velocidade",
        "stars": "Estrelas"
      }
    }
  },
  "background": "#02030A",
  "params": {
    "speed": {
      "label": "Speed",
      "type": "number",
      "min": 0,
      "max": 100,
      "default": 15
    },
    "stars": {
      "label": "Stars",
      "type": "number",
      "min": 10,
      "max": 160,
      "default": 70
    }
  },
  "layers": [
    {
      "type": "gradient",
      "colors": [
        "#020617",
        "#1E1B4B",
        "#0C1A3A"
      ],
      "angle": 90,
      "scale": 1.5,
      "speed": 8
    },
    {
      "type": "stars",
      "color": "#E0E7FF",
      "density": "$stars",
      "speed": "$speed",
      "blend": "add"
    }
  ]
}
